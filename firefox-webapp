#!/usr/bin/env bash
# Create or refresh a Firefox (firefox-frosted) web app: its own profile,
# launcher and dock icon, frosted COSMIC look, a minimal title bar.
#
#   firefox-webapp [--reset-frost] ID "Name" URL ICON.svg [frosted-host ...]
#
# ID          launcher / Wayland app_id / profile folder (e.g. gmail)
# frosted-host  hosts that start fully clear (page 0%, panels 50%) in
#               Frosted Pages; others use the extension defaults.
# Re-running keeps the profile's logins, toolbar layout and extension data.
# --reset-frost  replace the app's Frosted Pages settings with the hosts given
#                (the app must be closed).
# FROST_PANEL=N  panel opacity for the frosted hosts (default 50).
set -euo pipefail

reset_frost=0
if [ "${1:-}" = --reset-frost ]; then reset_frost=1; shift; fi
if [ $# -lt 4 ]; then
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
fi
id=$1 name=$2 url=$3 icon=$4
shift 4

main_profile=$HOME/.config/mozilla/firefox/dptldi9h.default-release
profile=$HOME/.local/share/firefox-webapps/$id
apps=$HOME/.local/share/applications
icon_dest=$HOME/.local/share/icons/hicolor/scalable/apps/$id-webapp.svg

mkdir -p "$profile/chrome" "$(dirname "$icon_dest")"
[ "$(realpath "$icon")" = "$(realpath -m "$icon_dest")" ] || cp "$icon" "$icon_dest"

cat > "$profile/user.js" <<EOF
// Generated by firefox-webapp; re-run it instead of editing.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.startup.page", 1);
user_pref("browser.startup.homepage", "$url");
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("browser.tabs.inTitlebar", 1);
user_pref("browser.toolbars.bookmarks.visibility", "never");
user_pref("sidebar.revamp", false);
user_pref("sidebar.verticalTabs", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("media.webspeech.synth.dont_notify_on_error", true);
user_pref("browser.tabs.closeWindowWithLastTab", true);
// firefox-frosted: compositor blur + Frosted Pages extension (same as main profile)
user_pref("widget.transparent-windows", true);
user_pref("widget.wayland.background-blur.enabled", true);
user_pref("widget.wayland.background-blur.popups", false);
user_pref("browser.tabs.allow_transparent_browser", true);
user_pref("extensions.autoDisableScopes", 11);
user_pref("extensions.startupScanScopes", 4);
// Memory: a web app is one site, so one shared web content process is enough
// (no per-site isolation, no preloaded spare process).
user_pref("fission.webContentIsolationStrategy", 0);
user_pref("dom.ipc.processCount", 1);
user_pref("dom.ipc.processCount.webIsolated", 1);
user_pref("dom.ipc.processPrelaunch.enabled", false);
EOF

# First run only: Frosted Pages button in the tab strip (the app's title bar).
if [ ! -e "$profile/prefs.js" ]; then
  cat > "$profile/prefs.js" <<'EOF'
user_pref("browser.uiCustomization.state", "{\"placements\":{\"widget-overflow-fixed-list\":[],\"unified-extensions-area\":[],\"nav-bar\":[\"back-button\",\"forward-button\",\"stop-reload-button\",\"customizableui-special-spring1\",\"vertical-spacer\",\"urlbar-container\",\"customizableui-special-spring2\",\"downloads-button\",\"unified-extensions-button\"],\"toolbar-menubar\":[\"menubar-items\"],\"TabsToolbar\":[\"tabbrowser-tabs\",\"frosted-pages_nemeth_local-browser-action\",\"new-tab-button\",\"alltabs-button\"],\"vertical-tabs\":[],\"PersonalToolbar\":[\"personal-bookmarks\"]},\"seen\":[\"frosted-pages_nemeth_local-browser-action\"],\"dirtyAreaCache\":[],\"currentVersion\":28,\"newElementCount\":0}");
EOF
fi

# Per-site Frosted Pages settings: written as the old JSON storage file, which
# Firefox migrates into the extension's (empty) IndexedDB store on next start.
ext=frosted-pages@nemeth.local
if [ $reset_frost = 1 ]; then
  if pgrep -f -- "--profile $profile( |$)" >/dev/null; then
    echo "$name is running; close it first" >&2; exit 1
  fi
  uuid=$(grep -o "$ext\\\\\":\\\\\"[0-9a-f-]*" "$profile/prefs.js" | grep -o '[0-9a-f-]\{36\}' || true)
  [ -n "$uuid" ] && rm -rf "$profile/storage/default/moz-extension+++$uuid^userContextId=4294967295"
  sed -i "/ExtensionStorageIDB.migrated.$ext/d" "$profile/prefs.js"
  rm -f "$profile/browser-extension-data/$ext/storage.js.migrated"
fi
if [ $# -gt 0 ] && { [ $reset_frost = 1 ] || [ ! -e "$profile/storage/default" ]; }; then
  data=$profile/browser-extension-data/$ext
  mkdir -p "$data"
  sites=$(for h in "$@"; do printf '"%s":{"enabled":true,"opacity":0,"panelOpacity":%s},' "$h" "${FROST_PANEL:-50}"; done)
  printf '{"sites":{%s}}\n' "${sites%,}" > "$data/storage.js"
fi

# COSMIC look comes from the main profile's stylesheet, so theme changes
# there reach every web app.
ln -sfn "$main_profile/chrome/userChrome.css" "$profile/chrome/cosmic.css"
cat > "$profile/chrome/userChrome.css" <<EOF
/* Generated by firefox-webapp; re-run it instead of editing. */
@import url("cosmic.css");

/* One tab: the tab strip is just a title bar (name, Frosted Pages button,
   window controls). A second tab brings back tabs and the URL bar. */
:root:not(:has(.tabbrowser-tab ~ .tabbrowser-tab)) :is(#tabbrowser-tabs, #new-tab-button, #alltabs-button, #firefox-view-button, #smartwindow-group-tabs-button, #ai-window-toggle),
:root:not(:has(.tabbrowser-tab ~ .tabbrowser-tab)) #nav-bar,
#PersonalToolbar { visibility: collapse !important; }

/* No separator line between the title bar and the page (Firefox draws it in
   a GTK system color that shows up on the focused window). */
:root {
  --chrome-content-separator-color: transparent !important;
}
#navigator-toolbox,
.browserContainer {
  border-block: none !important;
  outline: none !important;
}

:root:not(:has(.tabbrowser-tab ~ .tabbrowser-tab)) #TabsToolbar-customization-target::before {
  content: "$name";
  order: -1;
  flex: 1;
  align-self: center;
  padding-inline-start: 12px;
  font-weight: 600;
  color: var(--cosmic-on-bg);
  -moz-window-dragging: drag;
}
EOF

cat > "$apps/$id.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Exec=firefox --no-remote --profile $profile --name $id --class $id $url
Icon=$icon_dest
StartupWMClass=$id
Categories=Network;
Terminal=false
EOF
update-desktop-database "$apps" 2>/dev/null || true
echo "$name: $apps/$id.desktop (profile $profile)"
